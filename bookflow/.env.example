DATABASE_URL=postgres://bookflow:bookflow@localhost:5433/bookflow_dev
RUST_LOG=info,bookflow=debug,sqlx=warn
APP_PORT=3000

# Demo 部署账号（scripts/bootstrap-demo.sh / seed-demo.sh / reseed-demo.sh 使用）
DEMO_EMAIL=demo@bookflow.local
DEMO_PASSWORD=Demo123456
DEMO_DISPLAY_NAME=Bookflow 演示账号

# AI（Anthropic Messages 协议；可换 OpenAI 兼容代理，后端会自动判断）
AI_PROVIDER=anthropic               # anthropic | openai
AI_BASE_URL=https://api.anthropic.com
AI_API_KEY=sk-...
AI_MODEL=claude-sonnet-4-5
AI_IMAGE_MODEL=gpt-image-2
AI_TIMEOUT_SECS=60
# Anthropic prompt 缓存：对 system 段打 cache_control 断点，稳定前缀复用、变动正文不进缓存。
# 默认开启（省钱）。若上游代理不认 content-block 形式的 system，设为 0 回退纯字符串。
AI_PROMPT_CACHE=1                    # 1=开启(默认) | 0=关闭回退
