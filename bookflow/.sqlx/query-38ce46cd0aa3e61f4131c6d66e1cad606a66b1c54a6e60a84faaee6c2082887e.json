  "db_name": "PostgreSQL",
  "query": "\n            INSERT INTO chapters (project_id, idx, title)\n            VALUES (\n                $1,\n                COALESCE(\n                    (SELECT MAX(idx) + 1 FROM chapters WHERE project_id = $1),\n                    1\n                )::SMALLINT,\n                $2\n            )\n            RETURNING id, project_id, idx, title,\n                      beats AS \"beats: Json<Vec<Beat>>\",\n                      body, word_count, updated_at\n            ",
